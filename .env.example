# quant-core ayar dosyası.
# Kullanım: bu dosyayı ".env" adıyla kopyala ve değerleri doldur. .env dosyasını asla paylaşma, git'e koyma.
# Docker ile (docker compose) ve Docker'sız (python -m app.api.server) aynı dosya çalışır.
# Satır sonuna yorum yazma; yorumlar hep ayrı satırda olsun. Boş bırakılan değer varsayılanı kullanır.
# Listeler ve sözlükler tek satır JSON olarak yazılır.

# =====================================================================================
# 1) ÇALIŞMA MODU
# =====================================================================================
# PAPER   : Sanal para. Gerçek emir gitmez. Fiyat verisi borsanın herkese açık kanalından gelir. (varsayılan)
# TESTNET : Borsanın test ağı. Emirler gerçekten gider ama oyun parasıyladır. Test ağı API anahtarı gerekir.
# LIVE    : GERÇEK PARA. Aşağıdaki onay cümlesi, API anahtarları ve API_CONTROL_TOKEN zorunludur.
# Önce PAPER'da günlerce izle, sonra TESTNET, en son LIVE.
TRADING_MODE=PAPER

# Sadece LIVE için. Şu cümleyi birebir yaz (büyük harf, alt çizgilerle):
# I_UNDERSTAND_REAL_MONEY_IS_AT_RISK
# PAPER ve TESTNET'te boş kalmalı.
LIVE_TRADING_CONFIRMATION=

# =====================================================================================
# 2) BORSA (CCXT)
# =====================================================================================
# Desteklenen: binance | bybit
EXCHANGE_ID=binance
# PERPETUAL (vadesiz vadeli işlem) veya SPOT
EXCHANGE_MARKET=PERPETUAL
# Bunu elle true yapma. TESTNET modunda kod zaten test ağını açar; LIVE'da true olursa uygulama başlamaz.
EXCHANGE_TESTNET=false

# API anahtarı kuralları:
#  - "Para çekme" (withdraw) izni KAPALI olmalı. Sadece okuma ve işlem izni yeter.
#  - Anahtara IP kısıtlaması koy (sunucunun/bilgisayarının çıkış IP'si). Çok önerilir.
#  - TESTNET modunda test ağından alınan anahtarı kullan, gerçek hesabın anahtarını değil.
#  - PAPER modunda anahtar gerekmez.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Sadece parola isteyen borsalar için (örn. OKX). Binance ve Bybit'te boş bırak.
EXCHANGE_API_PASSWORD=

# =====================================================================================
# 3) HESAP VE SEMBOLLER
# =====================================================================================
# PAPER modunda sanal başlangıç bakiyesi
PAPER_STARTING_BALANCE=10000
QUOTE_CURRENCY=USDT
# İzlenecek işlem çiftleri (JSON listesi). Vadeli işlemde örnek: "BTC/USDT:USDT"; spotta: "BTC/USDT"
SYMBOLS=["BTC/USDT:USDT","ETH/USDT:USDT","SOL/USDT:USDT"]

# =====================================================================================
# 4) VERİTABANI VE REDIS
# =====================================================================================
# Bu üç değişkeni docker-compose kullanır (TimescaleDB konteynerini kurar ve uygulamaya bağlantıyı kendisi verir).
# Şifreyi değiştir. Sadece harf ve rakam kullan; @ : / # gibi karakterler bağlantı adresini bozar.
POSTGRES_USER=quant
POSTGRES_PASSWORD=degistir-bunu
POSTGRES_DB=quant

# Docker'sız çalıştırırsan (python -m app.api.server) bu adresler kullanılır.
# Docker Compose bunları kendi iç adresleriyle ezer, burada değiştirmen gerekmez.
# Şifre yukarıdaki POSTGRES_PASSWORD ile aynı olmalı. PostgreSQL yerine sqlite+aiosqlite:///./quant.db da olur (sadece deneme).
DATABASE_URL=postgresql+asyncpg://quant:degistir-bunu@localhost:5432/quant
REDIS_URL=redis://localhost:6379/0

# =====================================================================================
# 5) CLAUDE (KARAR MOTORU)
# =====================================================================================
ANTHROPIC_API_KEY=
# Kullanmak istediğin model kimliği. 6 saniyelik süre sınırı için hızlı bir model seç.
CLAUDE_MODEL=claude-sonnet-4-5
# Bu süreden uzun süren cevap HOLD sayılır (saniye)
CLAUDE_TIMEOUT_SECONDS=6
CLAUDE_MAX_OUTPUT_TOKENS=1200
# Kapalıyken modelin kendi varsayılanı kullanılır. Açarsan 0 ile 1 arası yaz.
# CLAUDE_TEMPERATURE=0.2
# Üst üste bu kadar hata olursa Claude çağrıları durur
CLAUDE_CIRCUIT_BREAKER_FAILURES=5
# Duruş süresi (saniye)
CLAUDE_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
# Her haber için Claude'a gönderilecek en fazla karakter
CLAUDE_MAX_NEWS_CHARS=600

# =====================================================================================
# 6) WEB TERMİNALİ VE KONTROL API'Sİ
# =====================================================================================
# Docker'sız çalışırken sadece bu bilgisayardan erişilir. Docker Compose bunu 0.0.0.0 yapar,
# ama portu bilgisayarda yalnızca 127.0.0.1 üzerinden açar. Uzaktan erişim istiyorsan önüne TLS'li bir proxy koy.
API_HOST=127.0.0.1
API_PORT=8000
# RESUME ve MARKET CLOSE butonları bu anahtarı ister. LIVE modda zorunlu, en az 16 karakter.
# Acil durdurma (kill-switch) butonu anahtarsız çalışır, durdurmak her zaman mümkün olmalı.
# Üretmek için:  python -c "import secrets;print(secrets.token_urlsafe(32))"
API_CONTROL_TOKEN=
# Grafikte açılacak varsayılan sembol. Kapalıyken SYMBOLS listesinin ilki.
# API_ACTIVE_SYMBOL=BTC/USDT:USDT
API_WS_MAX_CLIENTS=20
API_WS_SEND_QUEUE=500
API_WS_SNAPSHOT_DEADLINE_SECONDS=0.08
# WebSocket güncelleme aralığı (saniye). 0.2 = saniyede 5 kez.
API_WS_THROTTLE_SECONDS=0.2
# Tarayıcıdan bağlanmasına izin verilen adresler (JSON listesi). API_PORT'u değiştirirsen burayı da güncelle.
API_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# =====================================================================================
# 7) HABER KAYNAKLARI
# =====================================================================================
# İsteğe bağlı. Boşsa o kaynak atlanır, RSS kaynakları yine çalışır.
NEWS_CRYPTOPANIC_TOKEN=
NEWS_X_BEARER_TOKEN=
# Takip edilecek X hesapları (JSON listesi, @ işareti olmadan)
NEWS_X_ACCOUNTS=["federalreserve","SECGov","whale_alert","WatcherGuru"]
NEWS_POLL_INTERVAL_SECONDS=30
NEWS_REQUEST_TIMEOUT_SECONDS=10
NEWS_CACHE_MAX_ITEMS=2000
NEWS_CACHE_TTL_HOURS=24
NEWS_DEDUP_WINDOW=20000
# İki kaynaktaki benzer başlıkları aynı haber sayma eşiği (0-1)
NEWS_TITLE_SIMILARITY_THRESHOLD=0.85
# Bu saatten eski haberleri açılışta yok say
NEWS_MAX_AGE_HOURS=12
# Ek ayarlar (sözlük, JSON). Varsayılanlar kodda gömülü; sadece değiştirmek istersen aç:
# NEWS_RSS_FEEDS={"coindesk":"https://www.coindesk.com/arc/outboundfeeds/rss/","cointelegraph":"https://cointelegraph.com/rss"}
# NEWS_SYMBOL_KEYWORDS={"BTC":["bitcoin","btc"],"ETH":["ethereum","ether","eth"]}
# NEWS_MACRO_KEYWORDS={"FED":["fed","fomc","powell"],"CPI":["cpi","inflation"]}

# =====================================================================================
# 8) KATI RİSK LİMİTLERİ (Claude bunları değiştiremez)
# =====================================================================================
# Günlük en fazla kayıp (özsermayenin oranı). Aşılırsa kill-switch devreye girer.
RISK_MAX_DAILY_DRAWDOWN_PCT=0.03
RISK_MAX_LEVERAGE=5
# Stop çalışırsa bir işlemde kaybedilecek en fazla oran
RISK_MAX_RISK_PER_TRADE_PCT=0.005
# Tek pozisyonun nominal büyüklüğü / özsermaye
RISK_MAX_POSITION_NOTIONAL_PCT=0.5
# Tüm pozisyonların toplam nominal büyüklüğü / özsermaye
RISK_MAX_TOTAL_EXPOSURE_PCT=1.5
RISK_MAX_OPEN_POSITIONS=3
# Beklenen brüt kâr, ücretlerin en az kaç katı olmalı
RISK_MIN_FEE_COVER_MULTIPLE=2
RISK_MIN_NET_PROFIT_USD=0.01
# Her dolumda varsayılan kayma (baz puan). 2 = %0.02
RISK_DEFAULT_SLIPPAGE_BPS=2
# Marjin oranı bunu aşarsa bekçi pozisyonları kapatır
RISK_MAX_MARGIN_RATIO=0.8
RISK_MAX_STOP_DISTANCE_PCT=0.05
RISK_MIN_STOP_DISTANCE_PCT=0.001
# Kâr kaç R'ye ulaşınca stop başabaşa çekilsin
RISK_TRAILING_ACTIVATION_R=1
RISK_WATCHDOG_INTERVAL_SECONDS=1
RISK_MAX_CONSECUTIVE_LOSSES=5
# İşlem yasağı olan semboller (JSON listesi)
RISK_BLOCKED_SYMBOLS=[]

# =====================================================================================
# 9) EMİR İCRASI VE POZİSYON YÖNETİMİ
# =====================================================================================
# Sinyalden sonra fiyat ATR'nin bu katından fazla aleyhe giderse emir iptal
EXEC_MAX_DRIFT_ATR=0.3
# Her iki yönde bu kadar sıçrama olursa anormal sayılıp iptal
EXEC_MAX_ABS_DRIFT_ATR=1.0
EXEC_MAX_BOOK_AGE_SECONDS=2
EXEC_LIMIT_ENTRY_TIMEOUT_SECONDS=5
EXEC_ENTRY_FILL_POLL_SECONDS=0.2
# Stop emri konulamazsa kaç kez denensin; hâlâ olmazsa pozisyon acil kapatılır
EXEC_STOP_PLACE_RETRIES=3
EXEC_STOP_RETRY_BACKOFF_SECONDS=0.1
EXEC_EMERGENCY_CLOSE_RETRIES=3
EXEC_BREAKEVEN_TRIGGER_FEE_MULTIPLE=2
EXEC_BREAKEVEN_BUFFER_BPS=2
EXEC_TRAIL_ATR_MULTIPLE=1.0
EXEC_TRAIL_MIN_STEP_ATR=0.1
EXEC_TRAIL_MIN_INTERVAL_SECONDS=1
EXEC_MANAGER_POLL_SECONDS=1

# =====================================================================================
# 10) BORSA İLE DURUM UZLAŞTIRMA (RECON) VE LIVE BAŞLANGIÇ KONTROLÜ
# =====================================================================================
# Borsadaki pozisyonlarla yerel kayıtlar bu aralıkla karşılaştırılır (saniye)
RECON_INTERVAL_SECONDS=60
# Uygulamanın bilmediği (sahipsiz) pozisyona konacak sert stop, girişten uzaklık oranı
RECON_ORPHAN_STOP_PCT=0.02
# ADOPT_AND_PROTECT : sahipsiz pozisyonu devral ve stop koy
# CLOSE             : sahipsiz pozisyonu piyasa emriyle kapat
RECON_ORPHAN_ACTION=ADOPT_AND_PROTECT
# Sahipsiz pozisyonun nominal büyüklüğü / özsermaye bunu aşarsa kapatılır
RECON_MAX_ORPHAN_NOTIONAL_PCT=0.6
# Cross marjinli pozisyon bulunursa kapat
RECON_CLOSE_IF_CROSS_MARGIN=true
# LIVE başlangıcında hesapta en az bu kadar bakiye olmalı (USDT)
RECON_LIVE_MIN_BALANCE=50
# LIVE başlangıcında mevcut pozisyonların kaldıracı bunu aşmamalı
RECON_LIVE_MAX_EXISTING_LEVERAGE=5

# =====================================================================================
# 11) VERİ AKIŞI (DATA_)
# =====================================================================================
DATA_TIMEFRAME=1m
# Bu süreden uzun veri gelmezse akış STALE olur ve işlem açma durur (saniye)
DATA_STALE_AFTER_SECONDS=2
DATA_HEALTH_CHECK_INTERVAL_SECONDS=0.25
DATA_CANDLE_BUFFER_SIZE=1000
DATA_ORDERBOOK_DEPTH=20
DATA_LIQUIDATION_BUFFER_SIZE=500
DATA_RECONNECT_BASE_DELAY_SECONDS=0.5
DATA_RECONNECT_MAX_DELAY_SECONDS=30
DATA_RECONNECT_JITTER=0.2
# Bağlantı geri geldikten sonra bu kadar süre kesintisiz beklenip devam edilir
DATA_RESUME_AFTER_LIVE_SECONDS=1
# Açılışta REST ile geriye dönük çekilecek mum sayısı (göstergelerin ısınması için)
DATA_BOOTSTRAP_CANDLES=200

# =====================================================================================
# 12) SİNYAL ÜRETİMİ VE GÖSTERGELER (QUANT_)
# =====================================================================================
QUANT_RSI_PERIOD=14
QUANT_EMA_FAST=20
QUANT_EMA_SLOW=50
QUANT_BB_PERIOD=20
QUANT_BB_STD=2.0
QUANT_ATR_PERIOD=14
QUANT_VOLUME_Z_PERIOD=20
QUANT_OBI_LEVELS=10
QUANT_RSI_OVERSOLD=30
QUANT_RSI_OVERBOUGHT=70
QUANT_OBI_THRESHOLD=0.25
# Sadece bu puanın üstündeki kurulumlar Claude'a gider (0-1)
QUANT_MIN_CONFLUENCE_SCORE=0.7
QUANT_ATR_STOP_MULTIPLE=1.5
QUANT_ATR_TARGET_MULTIPLE=3.0
QUANT_MAX_SPREAD_BPS=5
# Ücret ön kontrolünde kullanılan referans işlem büyüklüğü (USDT)
QUANT_REFERENCE_NOTIONAL_USD=1000
# Aynı sembol ve yönde iki tetik arasındaki bekleme (saniye)
QUANT_TRIGGER_COOLDOWN_SECONDS=300
# Saatte en fazla kaç kez Claude çağrılır (maliyet sınırı)
QUANT_MAX_TRIGGERS_PER_HOUR=12
QUANT_EXPECTED_HOLDING_HOURS=2
QUANT_NEWS_LOOKBACK_MINUTES=120
QUANT_NEWS_IN_PAYLOAD=8

# =====================================================================================
# 13) SONRAKİ AŞAMA (şu an kullanılmıyor)
# =====================================================================================
# ABD hisseleri için Alpaca. Bu sürümde etkisi yok, boş bırakabilirsin.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
